# Conexión agrupada (PgBouncer / Transaction pooler - Puerto 6543 en Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (Para migraciones Prisma - Puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Puerto del servidor backend
PORT=3001

# Clave secreta para JWT
JWT_SECRET="supersecreto_cambiar_en_produccion"

# Entorno de ejecución
NODE_ENV="development"

# Notificaciones de Telegram (Opcionales para modo degradado / desarrollo)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID_OPERACIONES="-1001234567890"
TELEGRAM_CHAT_ID_INVENTARIO="-1001234567891"
TELEGRAM_CHAT_ID_ECOMMERCE="-1001234567892"