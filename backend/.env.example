# =====================================================================
# VARIABLES DE ENTORNO BACKEND (Producción: Render / Railway / Supabase)
# =====================================================================

# Cadena de conexión PostgreSQL (Supabase / Neon / Render Postgres / Railway)
# Puerto 6543 para pooler PgBouncer o 5432 directo
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?sslmode=require"

# Puerto del servidor backend
PORT=3001

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET="forma_jwt_production_secret_key_change_me"

# Entorno de ejecución
NODE_ENV="production"

# Contraseñas semilla (solo para seed/rotación; no dejar valores por defecto)
ADMIN_SEED_PASSWORD=""
VENDEDOR_SEED_PASSWORD=""
CLIENTE_SEED_PASSWORD=""

# Google Identity Services (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"

# Telegram Bot para Recibos y Notificaciones POS
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="Forma_Venta_Bot"

# Servicio de Correo Electrónico SMTP (Gmail / Resend / SendGrid / Ethereal)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_gmail"
EMAIL_FROM="Forma Atelier <tucorreo@gmail.com>"


# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://proyecto-forma-pos-pagina-web-ia.vercel.app"
