# Conexión agrupada (PgBouncer / Transaction pooler - Puerto 6543 en Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (Para migraciones Prisma - Puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Puerto del servidor backend
PORT=3001

# Clave secreta para JWT
JWT_SECRET="supersecreto_cambiar_en_produccion"

# Entorno de ejecución
NODE_ENV="development"

export type TipoNotificacion =
  | 'RECUPERACION_CLAVE'
  | 'ALERTA_STOCK_BAJO'
  | 'INCIDENCIA_PEDIDO'
  | 'CONFIRMACION_PEDIDO'
  | 'ALERTA_DESCUADRE_CAJA'
  | 'APERTURA_CIERRE_CAJA'
  | 'NUEVO_PEDIDO_WEB'
  | 'RESERVA_VENCIDA_LIBERADA';

export interface NotificacionPayload {
  destinatario?: string; // chat_id Telegram o email opcional (se deduce del canal si no se pasa)
  asunto: string;
  cuerpo: string;
  tipo: TipoNotificacion;
  datosExtra?: Record<string, unknown>;
}

export interface NotificacionPort {
  enviarNotificacion(payload: NotificacionPayload): Promise<boolean>;
}

# Notificaciones por Correo Transaccional (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="tu_usuario_smtp"
SMTP_PASS="tu_password_smtp"
SMTP_FROM="Forma Moda <pedidos@tiendaforma.com>"
SMTP_SECURE=false